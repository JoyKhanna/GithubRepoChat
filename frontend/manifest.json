{
  "manifest_version": 3,
  "name": "GitHub Repo Chat",
  "version": "1.0.0",
  "description": "Ask questions about any GitHub repository using OpenAI GPT (RAG)",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.github.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
